RESEND_API_KEY=re_xxxxxxxx
# Verified domain sender (change if your domain spelling differs)
RESEND_FROM=EliteDent <noreply@elitedent.com>
# Where new booking notifications are delivered
BOOKINGS_INBOX=djanieverlan@gmail.com

# Guide voice: Piper (free, open source), generated on the server.
# Setup:
#   python3 -m venv .piper/venv && .piper/venv/bin/pip install piper-tts
#   Download de_DE-thorsten-high and en_GB-alan-medium (.onnx + .onnx.json)
#   from https://huggingface.co/rhasspy/piper-voices into .piper/voices/
# Optional overrides:
PIPER_PYTHON=
PIPER_MODEL_DE=
PIPER_MODEL_EN=

# HKP admin (required to open /admin/)
HKP_ADMIN_PASSWORD=
# Auto-delete consultation data after N days (default 730 = 24 months)
HKP_RETENTION_DAYS=730

# HKP check is free/local (PDF text + optional system OCR).
# For photo / scanned-PDF checks, install on the server (optional):
#   macOS:  brew install tesseract tesseract-lang poppler
#   Debian: sudo apt install tesseract-ocr tesseract-ocr-deu poppler-utils
# Without OCR, text PDFs are still validated; photo-only uploads ask for a PDF.
